{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omnis Game Library",
  "mainBinaryName": "omnis",
  "version": "0.3.4",
  "identifier": "com.omnis.gamelibrary",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Omnis Game Library",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 600,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: tauri:; style-src 'self' 'unsafe-inline' asset: omnis-theme:; font-src 'self' asset: omnis-theme: data:; img-src 'self' asset: http://asset.localhost https://asset.localhost omnis-theme: https: data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost https: blob:; connect-src 'self' https: ipc: tauri:; script-src 'self' 'wasm-unsafe-eval';",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "High-performance reactive game library manager",
    "longDescription": "Omnis Game Library connects multiple platforms (Steam, Epic Games, Custom) with an immersive Fullscreen mode and extensive metadata enrichment.",
    "copyright": "Copyright © 2026 Omnis Game Library Team",
    "category": "Game",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      },
      "wix": {
        "language": "it-IT"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libappindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdENjBENDk0MUM5RkI0MzgKUldRNHRKOGNsTlJnZlNQTVhXRmkvUFJnbmZSdTVhUWlNdmRxUm1XL01ndGVqb3FHdHdLNm1zcVUK",
      "endpoints": [
        "https://github.com/rinaldinie/omins/releases/latest/download/latest.json"
      ]
    }
  }
}
