{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omnis Game Library",
  "version": "0.1.0",
  "identifier": "com.omnis.gamelibrary",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Omnis Game Library",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 600,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  }
}
