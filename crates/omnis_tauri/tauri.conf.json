{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omnis Game Library",
  "version": "0.1.0",
  "identifier": "com.omnis.gamelibrary",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Omnis Game Library",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 600,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "High-performance reactive game library manager",
    "longDescription": "Omnis Game Library connects multiple platforms (Steam, Epic Games, Custom) with an immersive Big Picture mode and extensive metadata enrichment.",
    "copyright": "Copyright © 2026 Omnis Game Library Team",
    "category": "Game",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      },
      "wix": {
        "language": "it-IT"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libappindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
